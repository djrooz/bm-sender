# Скопируйте в .env и заполните реальными значениями. .env в git не коммитить.

# Fireflies: Settings -> Developer Settings -> API Key
FIREFLIES_API_KEY=

# Telegram: токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram: chat_id группы кураторов, куда публикуются черновики отчётов
# (получить через getUpdates после того, как бот добавлен в группу)
TELEGRAM_CHAT_ID=

# ID гугл-таблицы со списком участников/родителей/мессенджеров
